function item_(){const ss=db_();let sh=ss.getSheetByName(ITEM);if(!sh){sh=ss.insertSheet(ITEM);sh.appendRow(['itemId','businessDate','type','name','amount','note','status','createdAt','updatedAt','revision'])}return sh}
function iobj_(r){return{itemId:String(r[0]),businessDate:String(r[1]),type:String(r[2]),name:String(r[3]),amount:+r[4]||0,note:String(r[5]||''),status:String(r[6]||'active'),revision:+r[9]||1}}
