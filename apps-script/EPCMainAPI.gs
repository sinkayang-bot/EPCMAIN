function settlementReport_(a,b,d){
 const rows=accountingList_(d||a,d||b).rows,events=[],groups={},members={};
 rows.forEach(acc=>{let ps=[];try{ps=listPlayers_(acc.eventId)}catch(_){};events.push({eventId:acc.eventId,businessDate:acc.businessDate,eventName:acc.eventName,level:acc.level,participants:acc.participants,totalGross:acc.totalGross,prizePool:acc.prizePool,adminNet:acc.adminNet,jp:acc.jp});ps.forEach(p=>{const g=String(p.group||'未分組').trim()||'未分組',key=p.memberKey||p.memberId,event=eo_(acc.eventId),paid=calcPlayerV3_(p,event).paid;if(!groups[g])groups[g]={group:g,members:{},totalPaid:0,totalPrize:0,net:0};if(!groups[g].members[key])groups[g].members[key]={memberKey:p.memberKey,memberId:p.memberId,name:p.name,paid:0,prize:0,net:0,events:0};const m=groups[g].members[key],prize=+p.prize||0;m.paid+=paid;m.prize+=prize;m.net=m.prize-m.paid;m.events++;groups[g].totalPaid+=paid;groups[g].totalPrize+=prize;members[key]=true})});
